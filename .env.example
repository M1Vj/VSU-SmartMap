# Run `npm run dev:bootstrap` to generate loopback-only values in `.env.local`.
# For a hosted deployment, use the project settings > API values instead.
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Optional private schedule account sync (disabled-first) ---
# Missing or non-"true" values fail closed to the device-only guest planner.
NEXT_PUBLIC_SCHEDULE_ACCOUNT_SYNC_ENABLED=false
# Supabase Auth Google identity provider credentials for local development.
# These are separate from the Gmail notification OAuth credentials below.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=

# Walking-route provider (optional). Without a key, routing uses the keyless
# OSRM-DE foot router (demo: ~1 req/s, non-commercial). Set ONE of the keys
# below for production. Precedence: Geoapify -> OpenRouteService -> OSRM.
#   Geoapify (recommended): https://geoapify.com — free, no card, key can be
#   restricted to your domain (safe to expose as NEXT_PUBLIC), 3000/day.
NEXT_PUBLIC_GEOAPIFY_KEY=
#   OpenRouteService: https://account.heigit.org — free, no card, 2000/day,
#   cleanest self-host path (key cannot be domain-locked; best for low traffic).
NEXT_PUBLIC_ORS_KEY=
# --- Turnstile (fail-closed in production) ---
# Set both keys in production. Server verification rejects requests when the
# secret is missing or Cloudflare verification cannot be completed. Local
# development uses Cloudflare's official test secret on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Public-write abuse controls ---
# Server-only HMAC pepper for rate-limit subject identifiers. Use a long random
# value in deployed environments; production requests fail closed when missing.
ABUSE_RATE_LIMIT_PEPPER=

# --- Scheduled storage retention ---
# Server-only bearer secret used by Vercel Cron for bounded upload reclamation.
CRON_SECRET=
GEMINI_API_KEYS=comma-separated-gemini-api-keys
GEMINI_MODEL_IDS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash

# --- Email notifications ---
# Gmail API is preferred for owner approval and admin workflow notifications.
# Gmail sending requires OAuth 2.0 credentials, not a plain API key.
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM="VSU SmartMap <your-gmail-address@gmail.com>"
# Resend remains supported as a fallback by setting EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM="VSU SmartMap <noreply@example.com>"

# --- Admin authorization (fail-closed) ---
# Comma-separated auth.users IDs that always receive the admin role (emergency recovery).
BREAK_GLASS_ADMIN_USER_IDS=
