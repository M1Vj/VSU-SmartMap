{
  "name": "vsu-smartmap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VSU-SmartMap deterministic offline map suite (Node >=22 required).",
  "engines": {
    "node": ">=22"
  },
  "volta": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "test": "node tools/run-tests.hermetic.mjs",
    "test:direct": "node tools/run-tests.mjs",
    "test:hermetic:selftest": "node --test tools/run-tests.hermetic.test.mjs",
    "test:map-e2e": "playwright test e2e/map-broad-smoke.spec.ts",
    "eval:chat": "node tools/evals/run-chat-evals.mjs",
    "preview:offline": "NEXT_PUBLIC_ENABLE_LOCAL_OFFLINE_SW=true next build && NEXT_PUBLIC_ENABLE_LOCAL_OFFLINE_SW=true next start",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "postcss": "8.5.28",
    "qs": "6.15.2",
    "sharp": "0.35.3",
    "underscore": "1.13.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "16.3.4",
    "@playwright/test": "1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "6.2.5",
    "genkit-cli": "^1.40.1",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}